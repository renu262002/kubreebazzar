# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret used to sign authentication tokens and demo payment signatures.
SESSION_SECRET="aetheria-spatial-commerce-secret-key"

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Optional live Razorpay credentials.
# When omitted, the server runs a full HMAC-SHA256 verified Razorpay checkout simulation.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Optional external Supabase project credentials.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
